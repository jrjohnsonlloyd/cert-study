 "5.1": [
  {
   "id": "5.1-01",
   "name": "Identify the problem - Gather information"
  },
  {
   "id": "5.1-02",
   "name": "Identify the problem - Question users"
  },
  {
   "id": "5.1-03",
   "name": "Identify the problem - Identify symptoms"
  },
  {
   "id": "5.1-04",
   "name": "Identify the problem - Determine if anything has changed"
  },
  {
   "id": "5.1-05",
   "name": "Identify the problem - Duplicate the problem, if possible"
  },
  {
   "id": "5.1-06",
   "name": "Identify the problem - Approach multiple problems individually"
  },
  {
   "id": "5.1-07",
   "name": "Establish a theory of probable cause - Question the obvious"
  },
  {
   "id": "5.1-08",
   "name": "Establish a theory of probable cause - Consider multiple approaches (Top-to-bottom/bottom-to-top OSI model, Divide and conquer)"
  },
  {
   "id": "5.1-09",
   "name": "Test the theory to determine the cause - If theory is confirmed, determine next steps to resolve problem"
  },
  {
   "id": "5.1-10",
   "name": "Test the theory to determine the cause - If theory is not confirmed, establish a new theory or escalate"
  },
  {
   "id": "5.1-11",
   "name": "Establish a plan of action to resolve the problem and identify potential effects"
  },
  {
   "id": "5.1-12",
   "name": "Implement the solution or escalate as necessary"
  },
  {
   "id": "5.1-13",
   "name": "Verify full system functionality and implement preventive measures if applicable"
  },
  {
   "id": "5.1-14",
   "name": "Document findings, actions, outcomes, and lessons learned throughout the process"
  }
 ],
